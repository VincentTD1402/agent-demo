# ${API_KEY} được image nginx thay bằng envsubst khi container khởi động
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;
    # Tải ảnh sản phẩm ở /nhan-vien (giới hạn thực tế do MAX_PRODUCT_IMAGE_MB của api)
    client_max_body_size 3m;

    # Ảnh sản phẩm do nhân viên tải lên (volume dùng chung với api); tên file ngẫu nhiên nên cache lâu được
    location /uploads/ {
        alias /usr/share/nginx/uploads/;
        expires 7d;
    }

    location /api/ {
        proxy_pass http://api:8000/;
        proxy_set_header X-API-Key "${API_KEY}";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 120s;
        # SSE (/api/chat/stream): không gom bộ đệm để token tới trình duyệt ngay
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
    }

    location / {
        try_files $uri /index.html;
    }
}
