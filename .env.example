# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env.
# Chạy trong Docker: dùng host.docker.internal / tên service. Chạy tay trên máy: dùng localhost (các dòng comment).

# ---- Ứng dụng ----
APP_PROJECT_NAME=Chatbot RAG
APP_DEBUG_MODE=false
APP_LOG_LEVEL=INFO
ENVIRONMENT=development
API_PORT=8000
FRONTEND_PORT=3000

# ---- Postgres ----
POSTGRES_HOST=chatbot-db-prod
POSTGRES_PORT=5432
# POSTGRES_HOST=localhost
# POSTGRES_PORT=6024
POSTGRES_DB=langchain
POSTGRES_USER=langchain
POSTGRES_PASSWORD=change-me-strong-password
# Cổng publish ra máy host (chỉ để debug bằng psql/GUI)
POSTGRES_PUBLIC_PORT=6024

# Connection pool
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_ENABLE_BM25=true

# ---- Embedding (server tự host, API tương thích OpenAI) ----
# API nhận cả dạng base (.../v1) lẫn đầy đủ (.../v1/embeddings)
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cpu
EMBEDDING_API_URL=https://your-api-model-host/embed/v1
# EMBEDDING_API_URL=http://localhost:8082/v1/embeddings
# Chỉ cần khi endpoint đòi Bearer token
EMBEDDING_API_KEY=
EMBEDDING_CHUNK_SIZE=1000
EMBEDDING_CHUNK_OVERLAP=200
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_S=60
EMBEDDING_CACHE_FOLDER=./models

# ---- Ảnh sản phẩm (nhân viên tải lên ở /nhan-vien) ----
# Thư mục ghi ảnh trong container api (volume product-images, nginx phục vụ ở /uploads/products/); tối đa MAX_PRODUCT_IMAGE_MB mỗi ảnh
PRODUCT_IMAGES_DIR=uploads/products
MAX_PRODUCT_IMAGE_MB=2

# ---- Nạp tài liệu (POST /documents/upload, /documents/ingest-folder) ----
# Thư mục gốc được phép quét theo folder (trong Docker được mount từ ./documents)
DOCUMENTS_DIR=documents
MAX_UPLOAD_MB=20
MAX_CONCURRENT_UPLOADS=3

# ---- RAG (agent LangGraph) ----
# Lấy RAG_TOP_K đoạn gần nhất bằng vector, rerank rồi giữ tối đa RAG_TOP_N đoạn có điểm >= RAG_MIN_SCORE
RAG_TOP_K=10
RAG_TOP_N=4
RAG_MIN_SCORE=0.3
# Nhiệt độ cho câu trả lời dựa trên tài liệu (thấp để bám sát nội dung)
RAG_ANSWER_TEMPERATURE=0.2
# Hội thoại dài hơn RAG_SUMMARIZE_AFTER tin nhắn thì tóm tắt phần cũ, giữ RAG_KEEP_MESSAGES tin gần nhất
RAG_SUMMARIZE_AFTER=12
RAG_KEEP_MESSAGES=6

# ---- Reranker ----
RERANKER_MODEL_NAME=Qwen/Qwen3-Reranker-0.6B
RERANKER_DEVICE=cpu
RERANKER_API_URL=https://your-api-model-host/rerank/v1
# RERANKER_API_URL=http://localhost:8083/v1/rerank

# ---- LLM mặc định ----
LLM_API_URL=https://your-api-model-host/qwen/v1
# LLM_API_URL=http://localhost:8080/v1/chat/completions
LLM_MODEL_NAME=Qwen/Qwen3-8B
LLM_TEMPERATURE=0.7
LLM_STREAMING=True
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60

# LLM profile "think"
LLM_LLM_CONFIGS__THINK__NAME=think
LLM_LLM_CONFIGS__THINK__API_URL=https://your-api-model-host/qwen/v1
# LLM_LLM_CONFIGS__THINK__API_URL=http://localhost:8080/v1/chat/completions
LLM_LLM_CONFIGS__THINK__MODEL_NAME=Qwen/Qwen3-8B
LLM_LLM_CONFIGS__THINK__TEMPERATURE=0.6
LLM_LLM_CONFIGS__THINK__STREAMING=True
LLM_LLM_CONFIGS__THINK__THINKING=true
LLM_LLM_CONFIGS__THINK__MAX_TOKENS=4096
LLM_LLM_CONFIGS__THINK__TIMEOUT=120

# LLM profile "no_think"
LLM_LLM_CONFIGS__NO_THINK__NAME=no_think
LLM_LLM_CONFIGS__NO_THINK__API_URL=https://your-api-model-host/qwen/v1
# LLM_LLM_CONFIGS__NO_THINK__API_URL=http://localhost:8080/v1/chat/completions
LLM_LLM_CONFIGS__NO_THINK__MODEL_NAME=Qwen/Qwen3-8B
# Mô hình thay thế: openai/gpt-oss-20b | Qwen/Qwen3-4B-Instruct-2507 | Qwen/Qwen3-30B-A3B-Instruct-2507-FP8
LLM_LLM_CONFIGS__NO_THINK__TEMPERATURE=0.1
LLM_LLM_CONFIGS__NO_THINK__STREAMING=True
LLM_LLM_CONFIGS__NO_THINK__MAX_TOKENS=1024
LLM_LLM_CONFIGS__NO_THINK__TIMEOUT=30

# ---- LLM ngoài (Gemini qua endpoint tương thích OpenAI) ----
# Dùng cho chitchat / câu hỏi ngoài phạm vi (fallback)
OPENAI_API_KEY=your-api-key
OPENAI_MODEL_NAME=gemini-3.5-flash
EXTERNAL_CHAT_ENABLED=true
EXTERNAL_CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EXTERNAL_CHAT_TEMPERATURE=0.7
EXTERNAL_CHAT_MAX_OUTPUT_TOKENS=8192
EXTERNAL_CHAT_TIMEOUT=60

# ---- LLM provider do người dùng chọn trên UI (openai | gemini) ----
# API key KHÔNG đặt ở đây: người dùng nhập trên frontend và gửi kèm request.
PROVIDER_OPENAI_BASE_URL=
PROVIDER_OPENAI_DEFAULT_MODEL=gpt-4o-mini
PROVIDER_OPENAI_MODELS=gpt-4o-mini,gpt-4o,gpt-4.1-mini
PROVIDER_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
PROVIDER_GEMINI_DEFAULT_MODEL=gemini-3.5-flash
PROVIDER_GEMINI_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-flash-latest,gemini-pro-latest
PROVIDER_TEMPERATURE=0.7
PROVIDER_MAX_OUTPUT_TOKENS=2048
PROVIDER_TIMEOUT=60

# ---- MCP server (tool giỏ hàng / đặt hàng / hoàn tiền) ----
# Agent gọi MCP server bằng Bearer MCP_API_KEY (sinh: openssl rand -hex 32). Thiếu khoá thì MCP server không chạy
# và agent tắt nhánh mua sắm.
MCP_SERVER_URL=http://mcp-server:8001/mcp
# MCP_SERVER_URL=http://localhost:8001/mcp
MCP_API_KEY=change-me-random-hex
MCP_PORT=8001
# Khoá API nhân viên (duyệt hoàn tiền, cập nhật trạng thái đơn) gửi qua header X-Staff-Key; để trống = tắt API nhân viên
STAFF_API_KEY=change-me-random-hex

# ---- Chống spam / lạm dụng ----
# Chat: tối đa N tin/phút và N tin/giờ cho mỗi phiên, N tin/phút cho mỗi IP; cùng một nội dung gửi lặp quá N lần/phút bị chặn
CHAT_RATE_PER_MINUTE=10
CHAT_RATE_PER_HOUR=120
CHAT_RATE_PER_IP_PER_MINUTE=30
CHAT_DUPLICATE_LIMIT=3
# Tra cứu đơn sai quá số lần theo mã đơn / theo SĐT trong cửa sổ N phút thì khoá tạm; tối đa N đơn mỗi phiên mỗi giờ
LOOKUP_MAX_FAILURES_PER_CODE=5
LOOKUP_MAX_FAILURES_PER_PHONE=10
LOOKUP_WINDOW_MINUTES=15
MAX_ORDERS_PER_SESSION_PER_HOUR=5

# ---- Chính sách cửa hàng (phải khớp documents/policies và nội dung UI) ----
SHIPPING_FEE_VND=30000
FREE_SHIPPING_FROM_VND=500000
# Hoàn tiền trong N ngày kể từ ngày giao; mỗi dòng giỏ tối đa MAX_QTY_PER_LINE (CSDL giới hạn 10)
REFUND_WINDOW_DAYS=7
MAX_QTY_PER_LINE=10

# ---- Bảo mật ----
# Sinh: openssl rand -hex 32
AUTH_SECRET_KEY=change-me
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_USERS=change-me
AUTH_PASSWORDS=change-me
# Frontend (nginx) gắn header X-API-Key khi proxy tới api; để trống = không kiểm tra/không gắn
API_KEY=
