# ---- Mô hình AI tự host (API tương thích OpenAI: vLLM, Ollama /v1, LM Studio, TGI...) ----
LLM_BASE_URL=http://your-model-server:8000/v1
LLM_API_KEY=changeme
LLM_MODEL=your-chat-model-name

# Embedding (để trống BASE_URL/API_KEY = dùng lại cấu hình LLM)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=your-embedding-model-name
EMBEDDING_DIMS=1024

# ---- Postgres + pgvector (container trong docker compose; checkpoint, store, dữ liệu shop) ----
POSTGRES_USER=shopbot
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=shopbot

# ---- API ----
# Để trống = tắt xác thực (chỉ dùng khi dev). Production: đặt chuỗi ngẫu nhiên dài.
API_KEY=
# Origin của frontend, phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
AGENT_MAX_STEPS=12
LOG_LEVEL=INFO
API_PORT=8000
FRONTEND_PORT=3000
