# ---- Mô hình AI tự host (API tương thích OpenAI: vLLM, Ollama /v1, LM Studio, TGI...) ----
LLM_BASE_URL=http://your-model-server:8000/v1
LLM_API_KEY=changeme
LLM_MODEL=your-chat-model-name
# LLM_TEMPERATURE=0.0
# LLM_TIMEOUT_S=60

# Embedding (để trống BASE_URL/API_KEY = dùng lại cấu hình LLM)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=your-embedding-model-name
EMBEDDING_DIMS=1024

# ---- Postgres + pgvector (container trong docker compose; checkpoint, store, dữ liệu shop) ----
# Tài khoản superuser của container: chỉ service `migrate` dùng (CREATE EXTENSION vector, tạo role). API/MCP không thấy.
# Các giá trị này được ghép vào URL kết nối: user/db chỉ chữ-số-gạch dưới; mật khẩu >= 12 ký tự, chỉ chữ-số.
POSTGRES_USER=shopbot
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=shopbot

# Mật khẩu 3 role DB do `migrate` tạo (shopbot_migrator: DDL; shopbot_app: SELECT bảng nghiệp vụ + DML bảng LangGraph; shopbot_mcp: quyền tối thiểu cho MCP).
# Mỗi mật khẩu: >= 12 ký tự, CHỈ chữ-số [A-Za-z0-9] (được nhúng vào URL kết nối), khác giá trị mẫu,
# và 3 mật khẩu + POSTGRES_PASSWORD phải khác nhau đôi một. Sinh: openssl rand -hex 24
MIGRATOR_DB_PASSWORD=change-me-migrator-password
APP_DB_PASSWORD=change-me-app-password
MCP_DB_PASSWORD=change-me-mcp-password
# Nạp sản phẩm/đơn mẫu khi bảng còn trống. CHỈ DÙNG KHI DEV: mặc định (khi bỏ biến) là false; production không đặt true.
SEED_DEMO_DATA=true

# Chạy migrate ngoài Docker (python -m app.db.bootstrap): DSN superuser, thay cho tổ hợp POSTGRES_* ở trên
# BOOTSTRAP_DATABASE_URL=postgresql://postgres:***@localhost:5432/shopbot
# DATABASE_URL (API: role shopbot_app; MCP: role shopbot_mcp) do docker-compose tự ghép; chỉ cần đặt khi chạy tay.

# ---- API ----
# Để trống = tắt xác thực (chỉ dùng khi dev). Production: đặt chuỗi ngẫu nhiên dài.
API_KEY=
# Origin của frontend, phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
AGENT_MAX_STEPS=12
LOG_LEVEL=INFO
API_PORT=8000
FRONTEND_PORT=3000

# Khoá Fernet mã hoá thông tin nhận tiền hoàn (bắt buộc, API không chạy nếu thiếu/sai).
# Sinh: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYOUT_ENCRYPTION_KEY=
# Chính sách vận chuyển / hoàn tiền
SHIPPING_FEE_VND=30000
FREE_SHIPPING_FROM_VND=500000
REFUND_WINDOW_DAYS=7

# ---- Ngân sách kết nối Postgres (mặc định đã đủ cho 1 replica API + 1 MCP + migrate) ----
# API dùng tối đa DB_POOL_MAX + SA_POOL_SIZE + SA_MAX_OVERFLOW + LANGGRAPH_POOL_MAX; MCP dùng DB_POOL_MAX của riêng nó.
# Tổng mọi replica + migrate (2) phải < max_connections của Postgres (mặc định 100).
# DB_POOL_MAX=5
# SA_POOL_SIZE=5
# SA_MAX_OVERFLOW=2
# LANGGRAPH_POOL_MAX=5
